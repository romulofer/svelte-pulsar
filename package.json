{
  "name": "svelte-pulsar",
  "version": "1.4.0",
  "main": "./lib/main.js",
  "description": "Syntax, diagnostics, and other smarts for svelte",
  "keywords": [
    "language",
    "grammar",
    "svelte",
    "pulsar",
    "ide"
  ],
  "author": "Rômulo Fernandes Evangelista (https://github.com/romulofer)",
  "repository": {
    "type": "git",
    "url": "https://github.com/romulofer/svelte-pulsar.git"
  },
  "homepage": "https://github.com/romulofer/svelte-pulsar#readme",
  "bugs": {
    "url": "https://github.com/romulofer/svelte-pulsar/issues"
  },
  "license": "MIT",
  "engines": {
    "atom": ">=1.21.0 <2.0.0"
  },
  "scripts": {
    "test": "pulsar --test test"
  },
  "atomTestRunner": "./test/runner",
  "consumedServices": {
    "linter-indie": {
      "versions": {
        "2.0.0": "consumeLinterV2"
      }
    },
    "datatip": {
      "versions": {
        "0.1.0": "consumeDatatip"
      }
    }
  },
  "providedServices": {
    "autocomplete.provider": {
      "versions": {
        "2.0.0": "provideAutocomplete"
      }
    },
    "code-format.range": {
      "versions": {
        "0.1.0": "provideCodeFormat"
      }
    },
    "code-highlight": {
      "versions": {
        "0.1.0": "provideCodeHighlight"
      }
    },
    "definitions": {
      "versions": {
        "0.1.0": "provideDefinitions"
      }
    },
    "find-references": {
      "versions": {
        "0.1.0": "provideFindReferences"
      }
    },
    "outline-view": {
      "versions": {
        "0.1.0": "provideOutlines"
      }
    }
  },
  "dependencies": {
    "atom-languageclient": "^1.16.1",
    "svelte-language-server": "^0.18.4"
  },
  "devDependencies": {
    "atom-mocha-test-runner": "^1.0.1",
    "chai": "^3.5.0",
    "mocha": "^3.4.2",
    "mocha-junit-and-console-reporter": "^1.6.0",
    "prettier": "github:helixbass/prettier#prettier-v2.1.0-dev.100-gitpkg",
    "prettier-plugin-coffeescript": "^0.1.5"
  }
}
